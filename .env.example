# Copy to .env only after the dedicated test database's network and TLS details
# have been reviewed. Do not put production credentials here.
APP_ENV=development
PORT=8000
DATABASE_ENABLED=false
DB_HOST=<test-database-host>
DB_PORT=<test-database-port>
DB_NAME=<test-database-name>
DB_USER=<test-database-user>
DB_PASSWORD=<test-database-password>
# Set only after approval: verify_identity, verify_ca, or disabled
DB_TLS_MODE=<approved-tls-mode>
DB_TLS_CA=<path-to-approved-ca-bundle>
SESSION_SECRET=<generate-a-long-random-secret>

# Microsoft Entra ID (production). Leave blank in offline local development.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
